import 'package:flutter/material.dart';

void main() {
  runApp(UglAutonomieFvgApp());
}

class UglAutonomieFvgApp extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'UGL Autonomie FVG',
      theme: ThemeData(
        // Colori UGL
        primaryColor: const Color(0xFF003882), // Blu UGL
        appBarTheme: const AppBarTheme(
          backgroundColor: Color(0xFF003882),
          foregroundColor: Colors.white,
        ),
        colorScheme: ColorScheme.fromSwatch().copyWith(
          secondary: const Color(0xFFFFC107), // Giallo/Oro UGL
        ),
      ),
      home: HomePage(),
    );
  }
}

class HomePage extends StatefulWidget {
  @override
  _HomePageState createState() => _HomePageState();
}

class _HomePageState extends State<HomePage> {
  int _currentIndex = 0;

  // Le 4 sezioni principali dell'app
  final List<Widget> _pages = [
    HomeContent(),
    ServiziContent(),
    ContrattiContent(),
    TesseraContent(),
  ];

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('UGL Autonomie FVG', style: TextStyle(fontWeight: FontWeight.bold)),
        actions: [
          IconButton(
            icon: const Icon(Icons.notifications),
            onPressed: () {
              // Qui si apriranno le notifiche (es. allerte scioperi)
            },
          )
        ],
      ),
      body: _pages[_currentIndex],
      bottomNavigationBar: BottomNavigationBar(
        currentIndex: _currentIndex,
        selectedItemColor: const Color(0xFF003882),
        unselectedItemColor: Colors.grey,
        onTap: (index) {
          setState(() {
            _currentIndex = index;
          });
        },
        items: const [
          BottomNavigationBarItem(icon: Icon(Icons.home), label: 'Home'),
          BottomNavigationBarItem(icon: Icon(Icons.support_agent), label: 'Servizi'),
          BottomNavigationBarItem(icon: Icon(Icons.menu_book), label: 'CCNL'),
          BottomNavigationBarItem(icon: Icon(Icons.badge), label: 'Tessera'),
        ],
      ),
    );
  }
}

